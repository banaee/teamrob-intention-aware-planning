# Generated file from scripts/env_layout_assembler.py
# configs/env1_layout.yaml  # let's keep it in repo 

# anywhere in subdirectories, ignore files starting with "my_"
**/my_*
**/archive_*

# anywhere in subdirectories, ignore files starting with "old_"
**/old_*

# add logs folder to ignore
logs/

# ignore all environment stuff .venv
.venv/

# ignore claude-related local settings
.claude/*

# extracted T10 realizer, written by F1's validate.py (its folder deleted 4 October 2026; last held by 32029d3)
analysis/**/_t10_realizer/

analysis/kitting/f47_fixtures/_scratch/

# analysis/ tracks reports and code only (.md, .py, .sh; Hadi, 2 October 2026, T-G housekeeping): data and figures stay
# on disk, untracked. The four test-bed sets regenerate theirs with each set's run script; the frozen kitting sets' data
# is restored in any clone with `git checkout 7d00f43 -- analysis/kitting/<set>` (analysis/README.md).
analysis/**/*.json
analysis/**/*.csv
analysis/**/*.png
analysis/**/*.txt

# the PNGs scripts/layout_tool.py writes beside the layout files ("render" and "edit"; regenerated by "render")
domains/*/layouts/*.png

analysis/**/separation.md
analysis/**/diff.md
analysis/**/summary.md
analysis/**/properties.md
analysis/**/measures.md

# T-viz reference images: third-party pictures, inspiration only, kept on disk and out of version control
