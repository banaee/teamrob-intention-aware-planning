{
  "name": "teamrob-presentation",
  "private": true,
  "version": "0.1.0",
  "description": "The deck of the TeamRob demo day's talk: reveal.js, drawn with the web-ui page's own code (webui/page/src).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pins": "node scripts/pins.mjs",
    "record": "node scripts/record.mjs",
    "dev": "npm run pins && npm run record && vite --open",
    "build": "npm run pins && npm run record && tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "pdf": "node scripts/pdf.mjs",
    "pdf:quick": "node scripts/pdf.mjs --quick",
    "pdf:steps": "node scripts/pdf.mjs --quick --steps"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reveal.js": "6.0.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
